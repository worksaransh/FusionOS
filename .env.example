# ==============================================================================
# FusionOS Enterprise ERP Platform — Environment Variable Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
PORT=5000
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + PgBouncer)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fusionos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_change_me
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=fusionos;Username=postgres;Password=postgres_dev_password_change_me;Include Error Detail=true;

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT + Refresh Tokens)
# ------------------------------------------------------------------------------
# IMPORTANT: SigningKey must be at least 256 bits (32+ characters) in production!
Jwt__SigningKey=FusionOS_Super_Secret_JWT_Signing_Key_For_Development_Only_Change_In_Prod_2026!
Jwt__Issuer=FusionOS.Host
Jwt__Audience=FusionOS.App
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# ------------------------------------------------------------------------------
# 4. REDIS CACHE & DISTRIBUTED LOCKS
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
ConnectionStrings__Redis=localhost:6379

# ------------------------------------------------------------------------------
# 5. KAFKA EVENT STREAMING & MESSAGING
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=fusionos-consumers

# ------------------------------------------------------------------------------
# 6. OPENTELEMETRY & OBSERVABILITY
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=FusionOS.Api
PROMETHEUS_METRICS_ENABLED=true

# ------------------------------------------------------------------------------
# 7. FRONTEND WEB CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_TITLE=FusionOS Enterprise ERP
VITE_ENABLE_ANALYTICS=false
